#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "config/desktop/theme.json"
GENERATED = Path.home() / ".config/dotfiles/generated"
HEX_COLOR = re.compile(r"#[0-9a-fA-F]{6}")


def load_theme() -> dict:
    with SOURCE.open() as theme_file:
        return json.load(theme_file)


def write_if_changed(path: Path, content: str) -> bool:
    content = content.rstrip() + "\n"
    if path.exists() and path.read_text() == content:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    return True


def qml_theme(theme: dict) -> str:
    properties = [
        f"    readonly property string fontFamily: {json.dumps(theme['font']['family'])}",
        f"    readonly property string symbolsFont: {json.dumps(theme['font']['symbols'])}",
        f'    readonly property color wallpaperAccent: Quickshell.env("DOTFILES_ACCENT") || "{theme["shell"]["accent"]}"',
        f'    readonly property color wallpaperAccentContainer: Quickshell.env("DOTFILES_ACCENT_CONTAINER") || "{theme["shell"]["activeSurface"]}"',
    ]
    dynamic_properties = {
        "mauve": "wallpaperAccent",
        "activeSurface": "wallpaperAccentContainer",
        "accent": "wallpaperAccent",
        "accentText": "wallpaperAccent",
    }
    for name, value in [*theme["palette"].items(), *theme["shell"].items()]:
        rendered = dynamic_properties.get(name, json.dumps(value))
        properties.append(f"    readonly property color {name}: {rendered}")

    return "\n".join(
        [
            "// Generated by bin/sync-desktop-theme from config/desktop/theme.json.",
            "pragma Singleton",
            "",
            "import QtQuick",
            "import Quickshell",
            "",
            "QtObject {",
            *properties,
            "",
            "    function alpha(color, opacity) {",
            "        return Qt.rgba(color.r, color.g, color.b, opacity)",
            "    }",
            "}",
        ],
    )


def waybar_theme(theme: dict) -> str:
    lines = [
        "/* Generated by bin/sync-desktop-theme from config/desktop/theme.json. */"
    ]
    for name, value in theme["palette"].items():
        lines.append(f"@define-color {name} {value};")
    for name, value in theme["shell"].items():
        lines.append(f"@define-color shell_{name} {value};")
    return "\n".join(lines)


def hypr_theme(theme: dict) -> str:
    lines = [
        "-- Generated by bin/sync-desktop-theme from config/desktop/theme.json.",
        "return {",
        "    palette = {",
    ]
    for name, value in theme["palette"].items():
        lines.append(f'        {name} = "{value.removeprefix("#")}",')
    lines.extend(["    },", "}"])
    return "\n".join(lines)


def dunst_theme(theme: dict) -> str:
    colors = theme["palette"]
    return f"""# Generated by bin/sync-desktop-theme from config/desktop/theme.json.
[global]
    frame_color = \"{colors["blue"]}\"

[urgency_low]
    background = \"{colors["base"]}E5\"
    foreground = \"{colors["text"]}\"
    frame_color = \"{colors["blue"]}\"

[urgency_normal]
    background = \"{colors["surface0"]}E5\"
    foreground = \"{colors["text"]}\"
    frame_color = \"{colors["green"]}\"

[urgency_critical]
    background = \"#2a1f24\"
    foreground = \"{colors["rosewater"]}\"
    frame_color = \"{colors["red"]}\"
"""


def sync_pi_theme(theme: dict) -> None:
    path = ROOT / "config/pi/themes/catppuccin-mocha-andrew.json"
    with path.open() as theme_file:
        pi_theme = json.load(theme_file)
    pi_theme["vars"] = theme["palette"]
    write_if_changed(path, json.dumps(pi_theme, indent=2))


def migrate_qml_colors() -> None:
    replacements = {
        '"#cdd6f4"': "Theme.text",
        '"#bac2de"': "Theme.subtext1",
        '"#a7abbe"': "Theme.mutedText",
        '"#7f849c"': "Theme.overlay1",
        '"#cba6f7"': "Theme.mauve",
        '"#f38ba8"': "Theme.red",
        '"#89b4fa"': "Theme.blue",
        '"#45475a"': "Theme.surface1",
        '"#585b70"': "Theme.surface2",
        '"#303140"': "Theme.surfaceInset",
        '"#393a4b"': "Theme.surfaceRaised",
        '"#4d3a55"': "Theme.dangerSurface",
        '"#d4ccff"': "Theme.accentText",
        '"#f8f8f2"': "Theme.primaryText",
        '"#8aff80"': "Theme.success",
        '"#ff9580"': "Theme.warning",
        '"#ff80bf"': "Theme.danger",
        '"#9580ff"': "Theme.accent",
        '"#626784"': "Theme.quietText",
        '"#414558"': "Theme.surface",
        '"#21222c"': "Theme.panel",
        '"#73414558"': "Theme.alpha(Theme.surface, 0.45)",
        '"#4d414558"': "Theme.alpha(Theme.surface, 0.30)",
        '"#33414558"': "Theme.alpha(Theme.surface, 0.20)",
        '"#66414558"': "Theme.alpha(Theme.surface, 0.40)",
        '"#cc21222c"': "Theme.alpha(Theme.panel, 0.80)",
        '"#3321222c"': "Theme.alpha(Theme.panel, 0.20)",
        '"#3d354f80"': "Theme.alpha(Theme.activeSurface, 0.24)",
        '"#4d9580ff"': "Theme.alpha(Theme.accent, 0.30)",
        '"#339580ff"': "Theme.alpha(Theme.accent, 0.20)",
        '"#809580ff"': "Theme.alpha(Theme.accent, 0.50)",
        '"#99ff80bf"': "Theme.alpha(Theme.danger, 0.60)",
        '"#33ff80bf"': "Theme.alpha(Theme.danger, 0.20)",
        '"#665f5575"': "Theme.alpha(Theme.hoverSurface, 0.40)",
        '"#66585b70"': "Theme.alpha(Theme.surface2, 0.40)",
        "Qt.rgba(33 / 255, 34 / 255, 44 / 255, 0.85)": "Theme.alpha(Theme.panel, 0.85)",
        "Qt.rgba(33 / 255, 34 / 255, 44 / 255, 0.90)": "Theme.alpha(Theme.panel, 0.90)",
        "Qt.rgba(33 / 255, 34 / 255, 44 / 255, 0.96)": "Theme.alpha(Theme.panel, 0.96)",
        "Qt.rgba(0, 0, 0, 0.22)": "Theme.alpha(Theme.crust, 0.22)",
    }

    qml_dir = ROOT / "config/quickshell/control-center"
    for path in qml_dir.glob("*.qml"):
        if path.name == "Theme.qml":
            continue
        content = path.read_text()
        for source, target in replacements.items():
            content = content.replace(source, target)
        write_if_changed(path, content)


def fallback_wallpaper_colors(theme: dict) -> dict[str, str]:
    return {
        "accent": theme["shell"]["accent"],
        "container": theme["shell"]["activeSurface"],
        "on_accent": theme["shell"]["panel"],
        "secondary": theme["palette"]["blue"],
        "tertiary": theme["palette"]["pink"],
    }


def resolve_generated_color(colors: dict, name: str) -> object:
    value = colors[name]
    for variant in ("dark", "default", "color"):
        if isinstance(value, dict) and variant in value:
            value = value[variant]
    return value


def wallpaper_colors(theme: dict, wallpaper: Path) -> dict[str, str]:
    colors = fallback_wallpaper_colors(theme)
    matugen = shutil.which("matugen")
    if matugen is None:
        print("matugen is not installed; using the default accent", file=sys.stderr)
        return colors

    result = subprocess.run(
        [
            matugen,
            "image",
            str(wallpaper),
            "--json",
            "hex",
            "--dry-run",
            "--prefer",
            "saturation",
            "--fallback-color",
            colors["accent"],
        ],
        capture_output=True,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        print(
            "matugen could not extract wallpaper colors; using the default accent",
            file=sys.stderr,
        )
        return colors

    try:
        color_data = json.loads(result.stdout)["colors"]
        dark = color_data.get("dark", color_data)
        generated = {
            "accent": resolve_generated_color(dark, "primary"),
            "container": resolve_generated_color(dark, "primary_container"),
            "on_accent": resolve_generated_color(dark, "on_primary"),
            "secondary": resolve_generated_color(dark, "secondary"),
            "tertiary": resolve_generated_color(dark, "tertiary"),
        }
    except (KeyError, TypeError, json.JSONDecodeError):
        print(
            "matugen returned an unexpected palette; using the default accent",
            file=sys.stderr,
        )
        return colors

    if not all(
        isinstance(value, str) and HEX_COLOR.fullmatch(value)
        for value in generated.values()
    ):
        print(
            "matugen returned an invalid color; using the default accent",
            file=sys.stderr,
        )
        return colors
    return generated


def apply_hyprland_accent(colors: dict[str, str]) -> None:
    hyprctl = shutil.which("hyprctl")
    if hyprctl is None:
        return
    border_colors = ", ".join(
        f'"rgba({colors[name].removeprefix("#")}ee)"'
        for name in ("accent", "secondary", "tertiary")
    )
    expression = (
        "hl.config({ general = { col = { active_border = { colors = { "
        + border_colors
        + " }, angle = 45 } } } })"
    )
    subprocess.run(
        [hyprctl, "eval", expression],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def apply_wallpaper_theme(theme: dict, wallpaper: Path, reload_apps: bool) -> None:
    if not wallpaper.is_file():
        raise SystemExit(f"Wallpaper does not exist: {wallpaper}")

    colors = wallpaper_colors(theme, wallpaper)
    state = {"wallpaper": str(wallpaper.resolve()), **colors}
    changed = write_if_changed(
        GENERATED / "desktop-accent.json", json.dumps(state, indent=2)
    )
    changed |= write_if_changed(
        Path.home() / ".config/waybar/accent.css",
        f"@define-color mauve {colors['accent']};",
    )
    changed |= write_if_changed(
        Path.home() / ".config/dunst/dunstrc.d/91-accent.conf",
        f'''[global]
    frame_color = "{colors["accent"]}"

[urgency_low]
    frame_color = "{colors["secondary"]}"

[urgency_normal]
    frame_color = "{colors["accent"]}"''',
    )
    changed |= write_if_changed(
        GENERATED / "ghostty-accent.conf",
        f"""cursor-color = {colors["accent"]}
selection-background = {colors["container"]}
selection-foreground = {theme["palette"]["text"]}""",
    )

    systemctl = shutil.which("systemctl")
    if systemctl is not None:
        subprocess.run(
            [
                systemctl,
                "--user",
                "set-environment",
                f"DOTFILES_ACCENT={colors['accent']}",
                f"DOTFILES_ACCENT_CONTAINER={colors['container']}",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    apply_hyprland_accent(colors)

    if reload_apps and changed and systemctl is not None:
        subprocess.run(
            [
                systemctl,
                "--user",
                "try-restart",
                "--no-block",
                "waybar.service",
                "quickshell-control-center.service",
                "dunst.service",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        subprocess.run(
            ["pkill", "-SIGUSR2", "ghostty"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--wallpaper", type=Path)
    parser.add_argument("--no-reload", action="store_true")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    theme = load_theme()
    if args.wallpaper is not None:
        apply_wallpaper_theme(theme, args.wallpaper.expanduser(), not args.no_reload)
        return

    write_if_changed(
        ROOT / "config/quickshell/control-center/Theme.qml", qml_theme(theme)
    )
    write_if_changed(ROOT / "config/waybar/theme.css", waybar_theme(theme))
    write_if_changed(ROOT / "config/hypr/conf/theme.lua", hypr_theme(theme))
    write_if_changed(ROOT / "config/dunst/dunstrc.d/90-theme.conf", dunst_theme(theme))
    sync_pi_theme(theme)
    migrate_qml_colors()


if __name__ == "__main__":
    main()
