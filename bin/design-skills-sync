#!/usr/bin/env bash
# Vendor the design skill library from its upstream repos into config/skills-library/design.
# Reads sources.tsv, sparse-fetches only the listed subpaths, and pins the resolved SHAs
# in sources.lock so a resync shows upstream drift as an ordinary git diff.

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${BASEDIR}/config/skills-library/design"
MANIFEST="${LIB}/sources.tsv"
LOCK="${LIB}/sources.lock"
INDEX="${LIB}/INDEX.md"

[ -f "${MANIFEST}" ] || {
  echo "no manifest at ${MANIFEST}" >&2
  exit 1
}

TMP="$(mktemp -d)"
trap 'rm -rf "${TMP}"' EXIT

manifest_rows() { grep -v '^#' "${MANIFEST}" | grep -v '^[[:space:]]*$'; }

repos="$(manifest_rows | cut -f1,2 | sort -u)"

: >"${TMP}/lock"

while IFS=$'\t' read -r repo ref; do
  echo "-> ${repo}@${ref}"
  clone="${TMP}/$(echo "${repo}" | tr '/' '_')"
  git clone --quiet --filter=blob:none --no-checkout --depth 1 --branch "${ref}" \
    "https://github.com/${repo}.git" "${clone}"

  patterns=()
  while IFS=$'\t' read -r r _ from _ excludes; do
    [ "${r}" = "${repo}" ] || continue
    patterns+=("/${from}/**")
    [ -n "${excludes}" ] || continue
    IFS=',' read -ra ex <<<"${excludes}"
    for pattern in "${ex[@]}"; do patterns+=("!/${pattern}"); done
  done < <(manifest_rows)
  patterns+=("/LICENSE*")

  git -C "${clone}" sparse-checkout set --no-cone "${patterns[@]}"
  git -C "${clone}" checkout --quiet
  printf '%s\t%s\t%s\n' "${repo}" "${ref}" "$(git -C "${clone}" rev-parse HEAD)" >>"${TMP}/lock"

  license="$(find "${clone}" -maxdepth 1 -iname 'LICENSE*' -type f | head -1)"
  if [ -n "${license}" ]; then
    mkdir -p "${LIB}/licenses"
    cp "${license}" "${LIB}/licenses/$(echo "${repo}" | tr '/' '-').LICENSE"
  else
    echo "  ! no LICENSE file in ${repo}" >&2
  fi
done <<<"${repos}"

while IFS=$'\t' read -r repo _ from to excludes; do
  src="${TMP}/$(echo "${repo}" | tr '/' '_')/${from}"
  [ -d "${src}" ] || {
    echo "  ! ${repo}:${from} did not materialize" >&2
    exit 1
  }
  rsync_excludes=()
  if [ -n "${excludes}" ]; then
    IFS=',' read -ra ex <<<"${excludes}"
    for pattern in "${ex[@]}"; do rsync_excludes+=(--exclude "${pattern#"${from}"/}"); done
  fi
  mkdir -p "${LIB}/${to}"
  rsync -a --delete "${rsync_excludes[@]}" "${src}/" "${LIB}/${to}/"
  printf '  %-42s %s\n' "${to}" "$(du -sh "${LIB}/${to}" | cut -f1)"
done < <(manifest_rows)

{
  echo "# Resolved upstream commits. Written by bin/design-skills-sync; do not hand-edit."
  printf '# repo\tref\tsha\n'
  sort "${TMP}/lock"
} >"${LOCK}"

write_lane() {
  local lane="$1"
  echo
  echo "## ${lane}"
  echo
  echo "| Path | What it covers |"
  echo "|---|---|"
  find "${LIB}/${lane}" -name SKILL.md | sort | while read -r skill; do
    awk -v path="${skill#"${LIB}/"}" '
      /^description: */ {
        sub(/^description: */, "")
        value = $0
        if (value ~ /^[>|]-?[[:space:]]*$/) {
          value = ""
          while ((getline line) > 0) {
            if (line ~ /^[^[:space:]]/) break
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
            if (line == "") continue
            value = (value == "" ? line : value " " line)
          }
        }
        gsub(/^["'"'"']|["'"'"']$/, "", value)
        gsub(/\|/, "/", value)
        if (length(value) > 160) value = substr(value, 1, 157) "..."
        printf "| `%s` | %s |\n", path, value
        exit
      }
    ' "${skill}"
  done
}

{
  echo "# Design skill library index"
  echo
  echo "Generated by \`bin/design-skills-sync\`. Do not hand-edit."
  echo "Paths are relative to \`~/.skills-library/design/\`."
  echo "Routing lives in the \`andrew-vibe-designer\` skill; this file is the full catalogue"
  echo "for when the router's table has no obvious match."
  for lane in judge fix taste build motion; do write_lane "${lane}"; done
} >"${INDEX}"

echo
echo "index:   $(grep -c '^| `' "${INDEX}") entries"
echo "library: $(du -sh "${LIB}" | cut -f1)"
