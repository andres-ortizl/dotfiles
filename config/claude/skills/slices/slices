"""slices: PR status with a JSON contract, loop-table edits and tests against another commit's source."""

import json
import os
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from enum import StrEnum
from pathlib import Path
from typing import Annotated, Any

import typer
from rich.console import Console
from rich.table import Table

try:
    from typer._click.exceptions import NoArgsIsHelpError, UsageError  # typer 0.29 vendors click
except ImportError:
    from click.exceptions import NoArgsIsHelpError, UsageError

SCHEMA = 1
EXIT_NOT_READY = 3
BOT_THRESHOLD = 4
COMPARE_FILE_CAP = 300
PR_URL = re.compile(r"github\.com/([^/\s]+)/([^/\s]+)/pull/(\d+)")
PR_SHORT = re.compile(r"^([^/#\s]+/[^/#\s]+)#(\d+)$")
OUTCOME_TAG = re.compile(r"\[(used|dup|dropped)")

app = typer.Typer(
    add_completion=False,
    rich_markup_mode=None,
    pretty_exceptions_enable=False,
    no_args_is_help=True,
    help="PR status for slice loops, loop-table edits, and tests against another commit's source.",
)


class CliError(Exception):
    """A failure the user can act on; main() prints it as one line."""


class GhError(CliError):
    def __init__(self, args: tuple[str, ...], reason: str):
        super().__init__(f"`gh {' '.join(args[:3])}` failed ({reason}); check `gh auth status` and the PR reference")
        self.reason = reason


class Kind(StrEnum):
    CI_PENDING = "ci_pending"
    CI_FAILED = "ci_failed"
    BOT_MISSING = "bot_missing"
    BOT_BELOW_THRESHOLD = "bot_below_threshold"
    BOT_STALE = "bot_stale"
    OPEN_THREADS = "open_threads"
    CONFLICT = "conflict"
    MERGEABLE_UNKNOWN = "mergeable_unknown"
    BASE_MOVED = "base_moved"
    STACK_PARENT_NOT_READY = "stack_parent_not_ready"
    DRAFT = "draft"


@dataclass
class Finding:
    kind: Kind
    detail: str
    data: dict[str, Any] = field(default_factory=dict)

    def to_json(self) -> dict[str, Any]:
        return {"kind": self.kind.value, "detail": self.detail, **self.data}


@dataclass
class PrStatus:
    pr: int
    repo: str
    url: str
    state: str
    base: str
    head: str
    head_ref: str
    merge_commit: str | None = None
    ci_state: str | None = None
    ci_failed: list[str] = field(default_factory=list)
    ci_pending: list[str] = field(default_factory=list)
    score: int | None = None
    reviewed_sha: str | None = None
    stale: bool = False
    open_threads: int = 0
    mergeable: str | None = None
    behind: int | None = None
    blockers: list[Finding] = field(default_factory=list)
    notes: list[Finding] = field(default_factory=list)

    @property
    def ready(self) -> bool:
        return self.state == "open" and not self.blockers

    def kinds(self) -> set[Kind]:
        return {b.kind for b in self.blockers}

    def to_json(self) -> dict[str, Any]:
        return {
            "pr": self.pr,
            "repo": self.repo,
            "url": self.url,
            "state": self.state,
            "base": self.base,
            "head": self.head,
            "head_ref": self.head_ref,
            "merge_commit": self.merge_commit,
            "ci": {"state": self.ci_state, "failed": self.ci_failed, "pending": self.ci_pending},
            "bot": {"score": self.score, "reviewed_sha": self.reviewed_sha, "stale": self.stale},
            "open_threads": self.open_threads,
            "mergeable": self.mergeable,
            "behind": self.behind,
            "ready": self.ready,
            "blockers": [b.to_json() for b in self.blockers],
            "notes": [n.to_json() for n in self.notes],
        }


def gh_raw(*args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(["gh", *args], capture_output=True, text=True)
    except FileNotFoundError:
        raise CliError("gh is not installed; install the GitHub CLI and run `gh auth login`") from None


def gh(*args: str) -> Any:
    done = gh_raw(*args)
    if done.returncode:
        reason = (done.stderr.strip().splitlines() or ["no error output"])[0]
        raise GhError(args, reason)
    return json.loads(done.stdout) if done.stdout.strip() else None


def gh_or_none(*args: str) -> Any:
    done = gh_raw(*args)
    if done.returncode or not done.stdout.strip():
        return None
    return json.loads(done.stdout)


def parse_targets(targets: list[str]) -> tuple[Path | None, list[tuple[str, int]]]:
    """A loop dir or loop.md gives every PR linked in it; otherwise each target is one PR reference."""
    first = Path(targets[0]).expanduser()
    if first.exists():
        loop = first / "loop.md" if first.is_dir() else first
        if not loop.is_file():
            raise CliError(f"no loop.md at {loop}; pass the loop folder or PR references")
        found = {(f"{o}/{r}", int(n)) for o, r, n in PR_URL.findall(loop.read_text())}
        return loop, sorted(found, key=lambda ref: ref[1])
    refs: list[tuple[str, int]] = []
    for target in targets:
        if short := PR_SHORT.match(target):
            refs.append((short[1], int(short[2])))
        elif url := PR_URL.search(target):
            refs.append((f"{url[1]}/{url[2]}", int(url[3])))
        else:
            raise CliError(f"not a PR reference: {target}; use a PR URL, owner/repo#N, or a loop folder")
    return None, refs


GREEN_CONCLUSIONS = {"SUCCESS", "NEUTRAL", "SKIPPED"}
FAILED_STATUS_STATES = {"FAILURE", "ERROR"}


def judge_check(entry: dict[str, Any]) -> str:
    """green, failed or pending; only a known-good outcome is green."""
    if "context" in entry:
        state = entry.get("state") or ""
        return "green" if state == "SUCCESS" else "failed" if state in FAILED_STATUS_STATES else "pending"
    if entry.get("status") != "COMPLETED":
        return "pending"
    return "green" if entry.get("conclusion") in GREEN_CONCLUSIONS else "failed"


def read_ci(status: PrStatus, rollup: list[dict[str, Any]]) -> None:
    for verdict, names in (("failed", status.ci_failed), ("pending", status.ci_pending)):
        for entry in rollup:
            name = entry.get("name") or entry.get("context") or "?"
            if judge_check(entry) == verdict and name not in names:
                names.append(name)
    if not rollup:
        status.ci_state = "none"
    elif status.ci_failed:
        status.ci_state = "failed"
    elif status.ci_pending:
        status.ci_state = "pending"
    else:
        status.ci_state = "ok"


def read_bot(repo: str, number: int, status: PrStatus) -> None:
    pages = gh("api", f"repos/{repo}/issues/{number}/comments", "--paginate", "--slurp") or []
    comments = [c for page in pages for c in page if re.search("greptile", (c.get("user") or {}).get("login", ""), re.I)]
    body = (comments[-1].get("body") or "") if comments else ""
    if score := re.search(r"Confidence Score: (\d)/5", body):
        status.score = int(score[1])
    if reviewed := re.search(r"Last reviewed commit:.*/commit/([0-9a-f]{7,40})", body):
        status.reviewed_sha = reviewed[1]
    # The score belongs to the commit the summary reviewed, which may be older than the head.
    status.stale = status.score is not None and not (
        status.reviewed_sha and status.head.startswith(status.reviewed_sha)
    )


THREADS_QUERY = """
query($owner:String!,$name:String!,$n:Int!,$after:String){ repository(owner:$owner,name:$name){ pullRequest(number:$n){
  reviewThreads(first:100, after:$after){ pageInfo{ hasNextPage endCursor }
    nodes{ isResolved comments(first:1){ nodes{ author{login} } } } } } } }
"""


def count_open_bot_threads(repo: str, number: int) -> int:
    owner, name = repo.split("/")
    total, cursor = 0, None
    while True:
        extra = ["-f", f"after={cursor}"] if cursor else []
        data = gh("api", "graphql", "-F", f"owner={owner}", "-F", f"name={name}", "-F", f"n={number}", *extra, "-f", f"query={THREADS_QUERY}")
        threads = data["data"]["repository"]["pullRequest"]["reviewThreads"]
        total += sum(
            1
            for t in threads["nodes"]
            if not t["isResolved"]
            and re.search("greptile", ((t["comments"]["nodes"] or [{}])[0].get("author") or {}).get("login") or "", re.I)
        )
        if not threads["pageInfo"]["hasNextPage"]:
            return total
        cursor = threads["pageInfo"]["endCursor"]


def base_moved(repo: str, number: int, status: PrStatus) -> Finding | None:
    """Commits that landed on the base since the PR's merge base and touch a file the PR changes; fails closed."""
    try:
        merge_base = gh("api", f"repos/{repo}/compare/{status.base}...{status.head}")["merge_base_commit"]["sha"]
        moved = gh("api", f"repos/{repo}/compare/{merge_base}...{status.base}")
        if not moved.get("ahead_by"):
            return None
        files = {f["filename"] for f in moved.get("files", [])}
        if len(moved.get("files", [])) >= COMPARE_FILE_CAP:
            detail = f"unknown: the base changed more than {COMPARE_FILE_CAP} files since the merge base; merge the base in"
            return Finding(Kind.BASE_MOVED, detail, {"commits": moved["ahead_by"], "files": None})
        pages = gh("api", f"repos/{repo}/pulls/{number}/files", "--paginate", "--slurp") or []
    except GhError as error:
        return Finding(Kind.BASE_MOVED, f"unknown: {error.reason}", {"commits": None, "files": None})
    overlap = sorted(files & {f["filename"] for page in pages for f in page})
    if not overlap:
        return None
    commits = moved["ahead_by"]
    return Finding(Kind.BASE_MOVED, f"{commits} commits on {status.base} since the merge base touch {len(overlap)} files of this PR", {"commits": commits, "files": overlap})


def fetch(repo: str, number: int) -> PrStatus:
    fields = "state,isDraft,baseRefName,headRefName,headRefOid,mergeable,mergeCommit,statusCheckRollup"
    pr = gh("pr", "view", str(number), "--repo", repo, "--json", fields)
    status = PrStatus(
        pr=number,
        repo=repo,
        url=f"https://github.com/{repo}/pull/{number}",
        state=pr["state"].lower(),
        base=pr["baseRefName"],
        head=pr["headRefOid"],
        head_ref=pr["headRefName"],
        merge_commit=(pr.get("mergeCommit") or {}).get("oid"),
    )
    if status.state != "open":
        return status
    rollup = pr.get("statusCheckRollup") or []
    read_ci(status, rollup)
    read_bot(repo, number, status)
    status.open_threads = count_open_bot_threads(repo, number)
    status.mergeable = pr["mergeable"]
    if status.mergeable == "UNKNOWN":
        # GitHub answers UNKNOWN while it computes mergeability on the first request.
        time.sleep(float(os.environ.get("SLICES_RETRY_SLEEP", "3")))
        status.mergeable = gh("pr", "view", str(number), "--repo", repo, "--json", "mergeable")["mergeable"]
    compare = gh_or_none("api", f"repos/{repo}/compare/{status.base}...{status.head}")
    status.behind = compare.get("behind_by") if compare else None

    if pr["isDraft"]:
        status.blockers.append(Finding(Kind.DRAFT, "the PR is a draft"))
    if status.ci_state == "failed":
        status.blockers.append(Finding(Kind.CI_FAILED, "CI failed: " + ",".join(status.ci_failed)))
    elif status.ci_state in ("none", "pending"):
        detail = "no CI checks yet" if status.ci_state == "none" else f"{len(status.ci_pending)} CI checks pending"
        status.blockers.append(Finding(Kind.CI_PENDING, detail))
    if status.score is None:
        status.blockers.append(Finding(Kind.BOT_MISSING, "no Greptile score"))
    elif status.score < BOT_THRESHOLD:
        status.blockers.append(Finding(Kind.BOT_BELOW_THRESHOLD, f"{status.score}/5"))
    if status.stale:
        # Today's rule: a 4/5 with every thread closed counts as 5/5 even on an older commit, so it is a note.
        reviewed = (status.reviewed_sha or "")[:8] or "unknown commit"
        status.notes.append(Finding(Kind.BOT_STALE, f"score reviewed {reviewed}, not the head"))
    if status.open_threads:
        status.blockers.append(Finding(Kind.OPEN_THREADS, f"{status.open_threads} Greptile threads open", {"count": status.open_threads}))
    if status.mergeable == "CONFLICTING":
        status.blockers.append(Finding(Kind.CONFLICT, "mergeable CONFLICTING"))
    elif status.mergeable != "MERGEABLE":
        status.blockers.append(Finding(Kind.MERGEABLE_UNKNOWN, f"mergeable {status.mergeable}"))
    if moved := base_moved(repo, number, status):
        status.blockers.append(moved)
    return status


def mark_stacked(statuses: list[PrStatus]) -> None:
    """A PR stacked on a listed open PR is ready only when that PR is; merged parents do not block."""
    by_head = {(s.repo, s.head_ref): s for s in statuses if s.state == "open"}
    own_blocked = {key for key, s in by_head.items() if s.blockers}
    for status in statuses:
        if status.state != "open":
            continue
        seen = {status.head_ref}
        parent = by_head.get((status.repo, status.base))
        while parent and parent.head_ref not in seen:
            if (parent.repo, parent.head_ref) in own_blocked:
                status.blockers.append(Finding(Kind.STACK_PARENT_NOT_READY, f"base #{parent.pr} not ready", {"parent": parent.pr}))
                break
            seen.add(parent.head_ref)
            parent = by_head.get((parent.repo, parent.base))


def default_branch(repo: str) -> str:
    return gh("repo", "view", repo, "--json", "defaultBranchRef")["defaultBranchRef"]["name"]


def is_protected(repo: str, branch: str) -> bool:
    """A protected base such as main or release/* is long-lived: its old PRs are not a stack parent."""
    return bool((gh_or_none("api", f"repos/{repo}/branches/{branch}") or {}).get("protected"))


def lookup_parent(repo: str, base: str) -> Finding | PrStatus | None:
    """The PR whose head is this base branch: a blocker when it is gone, its status when it is open."""
    try:
        parents = gh("pr", "list", "--repo", repo, "--head", base, "--state", "all", "--json", "number,state") or []
    except GhError as error:
        return Finding(Kind.STACK_PARENT_NOT_READY, f"unknown: {error.reason}")
    if not parents:
        return None
    parent = next((p for p in parents if p["state"] == "OPEN"), parents[0])
    if parent["state"] == "OPEN":
        return fetch(repo, parent["number"])
    return Finding(
        Kind.STACK_PARENT_NOT_READY,
        f"base branch belongs to {parent['state'].lower()} #{parent['number']}; retarget",
        {"parent": parent["number"]},
    )


def collect(refs: list[tuple[str, int]]) -> list[PrStatus]:
    with ThreadPoolExecutor(max_workers=8) as pool:
        statuses = list(pool.map(lambda ref: fetch(*ref), refs))
    known = {(s.repo, s.head_ref) for s in statuses if s.state == "open"}
    helpers: list[PrStatus] = []
    queue = [s for s in statuses if s.state == "open"]
    while queue:
        child = queue.pop()
        if (child.repo, child.base) in known or child.base == default_branch(child.repo) or is_protected(child.repo, child.base):
            continue
        found = lookup_parent(child.repo, child.base)
        if isinstance(found, Finding):
            child.blockers.append(found)
        elif found:
            known.add((found.repo, found.head_ref))
            helpers.append(found)
            queue.append(found)
    mark_stacked(statuses + helpers)
    return statuses


def count_open_signals(loop: Path | None) -> int | None:
    signals = loop.parent / "signals.md" if loop else None
    if not signals or not signals.is_file():
        return None
    lines = [line for line in signals.read_text().splitlines() if line.startswith("- ")]
    return sum(1 for line in lines if not OUTCOME_TAG.search(line))


def plain_line(s: PrStatus) -> str:
    if s.state != "open":
        tail = (s.merge_commit or "")[:8] if s.state == "merged" else ""
        return f"#{s.pr} {s.state} {tail}".rstrip()
    score = "-" if s.score is None else f"{s.score}/5" + (f" stale@{(s.reviewed_sha or '')[:8]}" if s.stale else "")
    behind = "?" if s.behind is None else s.behind
    ready = "yes" + "".join(f" ({n.detail})" for n in s.notes) if s.ready else "no: " + "; ".join(b.detail for b in s.blockers)
    return (
        f"#{s.pr} {s.state} ->{s.base} {s.head[:8]} CI {s.ci_state} Greptile {score} "
        f"{s.open_threads} open {s.mergeable} {behind} behind READY {ready}"
    )


def render(statuses: list[PrStatus], signals_open: int | None) -> None:
    if sys.stdout.isatty() and "NO_COLOR" not in os.environ:
        table = Table()
        for column in ("PR", "State", "Base", "Head", "CI", "Greptile", "Threads", "Mergeable", "Behind", "Ready"):
            table.add_column(column)
        for s in statuses:
            if s.state != "open":
                table.add_row(f"#{s.pr}", s.state, "", (s.merge_commit or "")[:8], "", "", "", "", "", "")
                continue
            score = "-" if s.score is None else f"{s.score}/5" + (" (stale)" if s.stale else "")
            ready = "[green]yes[/green]" if s.ready else "[red]no[/red] " + "; ".join(b.detail for b in s.blockers)
            behind = "?" if s.behind is None else str(s.behind)
            table.add_row(f"#{s.pr}", s.state, s.base, s.head[:8], s.ci_state or "", score, str(s.open_threads), s.mergeable or "", behind, ready)
        Console().print(table)
    else:
        for s in statuses:
            print(plain_line(s))
    if signals_open is not None:
        print(f"signals: {signals_open} without outcome")


def waiting(statuses: list[PrStatus]) -> list[PrStatus]:
    return [s for s in statuses if s.kinds() & {Kind.CI_PENDING, Kind.BOT_MISSING, Kind.MERGEABLE_UNKNOWN}]


@app.command(
    epilog="Example: slices status ~/.artifacts/myrepo/loops/my-epic --check --wait",
)
def status(
    targets: Annotated[list[str], typer.Argument(help="A loop folder or loop.md, or PR URLs / owner/repo#N")],
    as_json: Annotated[bool, typer.Option("--json", help="Print the JSON contract (schema 1) instead of text")] = False,
    check: Annotated[bool, typer.Option("--check", help="Exit 3 when any open PR is not ready")] = False,
    wait: Annotated[bool, typer.Option("--wait", help="Poll until no PR has ci_pending, bot_missing or mergeable_unknown")] = False,
    timeout: Annotated[int, typer.Option("--timeout", help="Seconds --wait polls before it exits 1")] = 1800,
    interval: Annotated[int, typer.Option("--interval", help="Seconds between --wait polls")] = 60,
) -> None:
    """One result per PR: state, CI, review bot, threads, mergeability and every blocker.

    A merged or closed PR has ready false and no blockers. A stale bot score is a note, not a blocker.
    base_moved means commits on the base since the PR's merge base touch a file the PR changes.
    """
    loop, refs = parse_targets(targets)
    if not refs:
        raise CliError("no PR links in the loop file; add the PR URLs to loop.md or pass PR references")
    deadline = time.monotonic() + timeout
    statuses = collect(refs)
    while wait and (pending := waiting(statuses)):
        if time.monotonic() >= deadline:
            names = ", ".join(f"#{s.pr}" for s in pending)
            raise CliError(f"timed out after {timeout}s waiting for CI or the review bot on {names}; rerun with a longer --timeout")
        time.sleep(interval)
        statuses = collect(refs)
    signals_open = count_open_signals(loop)
    if as_json:
        print(json.dumps({"schema": SCHEMA, "prs": [s.to_json() for s in statuses], "signals_open": signals_open}, indent=2))
    else:
        render(statuses, signals_open)
    if check and any(s.state == "open" and not s.ready for s in statuses):
        raise typer.Exit(EXIT_NOT_READY)


def cells(line: str) -> list[str]:
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


@app.command(
    epilog='Example: slices row loop.md "Slices" S1 Status "done (merged 2026-11-11)"',
)
def row(
    file: Annotated[Path, typer.Argument(help="The loop file")],
    section: Annotated[str, typer.Argument(help="Heading text of the section that holds the table")],
    key: Annotated[str, typer.Argument(help="First cell of the row, matched exactly")],
    column: Annotated[str, typer.Argument(help="Column name")],
    value: Annotated[str, typer.Argument(help="New cell value")],
) -> None:
    """Set one cell of one row in a markdown table, found by section heading and exact first cell."""
    if not file.is_file():
        raise CliError(f"no file {file}")
    lines = file.read_text().split("\n")
    start = next((i for i, line in enumerate(lines) if line.startswith("#") and line.lstrip("#").strip() == section), None)
    if start is None:
        raise CliError(f"no section '{section}' in {file}; use the heading text without the #")
    header = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("|")), None)
    if header is None:
        raise CliError(f"section '{section}' has no table")
    names = cells(lines[header])
    if column not in names:
        raise CliError(f"no column '{column}' in section '{section}'; columns are {names}")
    matches = []
    for i in range(header + 2, len(lines)):
        if not lines[i].startswith("|"):
            break
        if cells(lines[i])[0] == key:
            matches.append(i)
    if len(matches) != 1:
        raise CliError(f"expected one row '{key}' in section '{section}', found {len(matches)}")
    updated = cells(lines[matches[0]])
    updated[names.index(column)] = value.replace("|", "\\|")
    lines[matches[0]] = "| " + " | ".join(updated) + " |"
    file.write_text("\n".join(lines))
    print(lines[matches[0]])


def git(*args: str, cwd: Path) -> str:
    try:
        done = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    except FileNotFoundError:
        raise CliError("git is not installed") from None
    if done.returncode:
        reason = (done.stderr.strip().splitlines() or ["no error output"])[0]
        raise CliError(f"`git {' '.join(args[:2])}` failed in {cwd} ({reason})")
    return done.stdout.strip()


def editable_roots(tree: Path) -> tuple[Path, list[Path]]:
    """The venv's site-packages and the paths inside the worktree that its .pth files put on sys.path."""
    sites = sorted((tree / ".venv" / "lib").glob("python*/site-packages"))
    if not sites:
        raise CliError(f"no site-packages in {tree}/.venv; run `uv sync` in {tree} first")
    roots: list[Path] = []
    for pth in sorted(sites[0].glob("*.pth")):
        for line in pth.read_text().splitlines():
            entry = line.strip()
            if not entry or entry.startswith(("#", "import ")):
                continue
            path = (sites[0] / entry).resolve()
            if path.is_relative_to(tree) and not path.is_relative_to(tree / ".venv") and path not in roots:
                roots.append(path)
    if not roots:
        raise CliError(f"no editable install of {tree} in its .pth files; run `uv sync` in {tree} first")
    return sites[0], roots


@app.command(
    "run-at-sha",
    epilog="Example: slices run-at-sha ~/code/repo/.claude/worktrees/my-slice 274e756313 -- cli/tests/test_x.py -q",
)
def run_at_sha(
    worktree: Annotated[Path, typer.Argument(help="The worktree whose test files run")],
    sha: Annotated[str, typer.Argument(help="Commit whose source the tests import")],
    pytest_args: Annotated[list[str] | None, typer.Argument(help="Arguments for pytest, after --")] = None,
) -> None:
    """Run the worktree's own tests against another commit's source, so a new test fails at the parent commit.

    Adds a detached worktree at SHA and maps each editable install of the worktree's .venv to the same
    path there. It runs the venv's pytest with those paths first and without the venv's own .pth files,
    then removes the detached worktree. Exits with pytest's code.
    """
    tree = worktree.expanduser().resolve()
    if sha.startswith("-"):
        raise CliError(f"not a commit: {sha}")
    python = tree / ".venv" / "bin" / "python"
    if not python.is_file():
        raise CliError(f"no {python}; run `uv sync` in {tree} first")
    full = git("rev-parse", "--verify", "--end-of-options", f"{sha}^{{commit}}", cwd=tree)
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=tree))
    dest = common.parent / ".claude" / "worktrees" / f"run-at-sha-{full[:10]}"
    if dest.exists():
        raise CliError(f"{dest} exists; remove it with `git worktree remove --force {dest}`")
    git("worktree", "add", "--detach", str(dest), full, cwd=tree)
    try:
        site, roots = editable_roots(tree)
        mapped: list[Path] = []
        for root in roots:
            old = dest / root.relative_to(tree)
            if old.is_dir():
                mapped.append(old)
                print(f"run-at-sha: {root} -> {old}", flush=True)
            else:
                print(f"run-at-sha: {root} -> (missing at {full[:10]}, left out)", flush=True)
        # -S and -P keep the worktree's own .pth entries and its cwd off sys.path, so only the old paths import.
        search = os.pathsep.join([*map(str, mapped), str(site), *filter(None, [os.environ.get("PYTHONPATH")])])
        result = subprocess.run(
            [str(python), "-S", "-P", "-m", "pytest", *(pytest_args or [])],
            cwd=tree,
            env={**os.environ, "PYTHONPATH": search},
        )
    finally:
        removal = subprocess.run(["git", "-C", str(tree), "worktree", "remove", "--force", str(dest)], capture_output=True, text=True)
        if removal.returncode:
            print(f"slices: could not remove {dest}; run `git worktree remove --force {dest}`", file=sys.stderr)
    raise typer.Exit(result.returncode)


def main() -> None:
    try:
        code = app(standalone_mode=False)
    except NoArgsIsHelpError as error:
        print(error.ctx.get_help() if error.ctx else error.format_message())
        sys.exit(0)
    except UsageError as error:
        command = f" {error.ctx.command_path}" if error.ctx else ""
        message = " ".join(error.format_message().split())
        print(f"slices: {message}; see `{command.strip() or 'slices'} --help`", file=sys.stderr)
        sys.exit(1)
    except typer.Abort:
        print("slices: aborted", file=sys.stderr)
        sys.exit(1)
    except CliError as error:
        print(f"slices: {error}", file=sys.stderr)
        sys.exit(1)
    except Exception as error:
        print(f"slices: unexpected {type(error).__name__}: {error}; rerun with a PR reference or loop folder, and report this", file=sys.stderr)
        sys.exit(1)
    sys.exit(code or 0)


if __name__ == "__main__":
    main()
