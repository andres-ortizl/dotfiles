#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
    printf 'Usage: %s COMMAND [ARG ...]\n' "$0" >&2
    exit 2
fi

if ! command -v systemd-run >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    exec "$@"
fi

command_name=${1##*/}
command_name=${command_name//[^[:alnum:]_.-]/-}
command_name=${command_name:0:48}
scope="app-${command_name:-gui}-${BASHPID}.scope"

exec systemd-run \
    --user \
    --scope \
    --collect \
    --quiet \
    --slice=app.slice \
    --unit="$scope" \
    -- \
    "$@"
