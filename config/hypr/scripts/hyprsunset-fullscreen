#!/usr/bin/env bash
set -euo pipefail

readonly socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

apply_state() {
    "$HOME/.config/hypr/scripts/night-shift" apply >/dev/null 2>&1 || true
}

for _ in {1..20}; do
    hyprctl hyprsunset profile >/dev/null 2>&1 && break
    sleep 0.1
done

apply_state
socat -U - UNIX-CONNECT:"$socket" | while IFS= read -r event; do
    case "${event%%>*}" in
        fullscreen | openwindow | closewindow | activewindowv2 | changefloatingmode)
            apply_state
            ;;
    esac
done
