#!/usr/bin/env bash
set -euo pipefail

export AWWW_TRANSITION=outer
export AWWW_TRANSITION_STEP=100
export AWWW_TRANSITION_DURATION=1.5
export AWWW_TRANSITION_FPS=144
export AWWW_TRANSITION_ANGLE=180
export AWWW_TRANSITION_POS=0.6877,0.975
export AWWW_TRANSITION_BEZIER=.4,0.02,0.21,0.99

readonly wallpaper_dir="$HOME/.config/wallpaper"
readonly state_file="$HOME/.config/hypr/store/wallpaper"

mapfile -t wallpapers < <(
    find -L "$wallpaper_dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        -printf '%f\n' | sort
)
((${#wallpapers[@]} > 0)) || {
    printf 'No wallpapers found in %s\n' "$wallpaper_dir" >&2
    exit 1
}

index=1
if [[ -f $state_file ]]; then
    read -r index <"$state_file"
fi
if [[ ! $index =~ ^[0-9]+$ ]] || ((index < 1 || index > ${#wallpapers[@]})); then
    index=1
fi

case "${1:-}" in
    startup)
        mode=Startup
        ;;
    "")
        index=$((index % ${#wallpapers[@]} + 1))
        mode=Cycle
        ;;
    *[!0-9]*)
        printf 'Usage: %s [startup|INDEX]\n' "$0" >&2
        exit 2
        ;;
    *)
        ((1 <= $1 && $1 <= ${#wallpapers[@]})) || {
            printf 'Wallpaper index must be between 1 and %d\n' "${#wallpapers[@]}" >&2
            exit 2
        }
        index=$1
        mode=Direct
        ;;
esac

mkdir -p "$(dirname "$state_file")"
printf '%d\n' "$index" >"$state_file"

if ! pgrep -x awww-daemon >/dev/null; then
    awww-daemon &
    for _ in {1..20}; do
        pgrep -x awww-daemon >/dev/null && break
        sleep 0.1
    done
fi

wallpaper="$wallpaper_dir/${wallpapers[index - 1]}"
printf '[MODE] %s\n[INFO] Setting wallpaper %d (%s)\n' \
    "$mode" "$index" "${wallpapers[index - 1]}"
awww img "$wallpaper" -o DP-3
"$HOME/.config/hypr/scripts/apply-wallpaper-theme" "$wallpaper"
