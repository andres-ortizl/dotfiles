[
  {
    "bindings": {
      "alt-1": null,
      "alt-2": null
    },
    "context": "Editor"
  },
  {
    "bindings": {
      "alt-1": "workspace::ToggleLeftDock",
      "alt-2": "workspace::ToggleRightDock",
      "alt-a": "agent::ToggleFocus",
      "alt-b": "editor::GoToDefinition",
      "alt-d": "debug_panel::ToggleFocus",
      "alt-down": "workspace::ActivatePaneDown",
      "alt-e": "project_panel::ToggleFocus",
      "alt-g": "git_panel::ToggleFocus",
      "alt-left": "workspace::ActivatePaneLeft",
      "alt-n": "notification_panel::ToggleFocus",
      "alt-o": "outline_panel::ToggleFocus",
      "alt-right": "workspace::ActivatePaneRight",
      "alt-shift-b": "editor::ToggleGitBlameInline",
      "alt-shift-i": "editor::ToggleInlayHints",
      "alt-t": "terminal_panel::ToggleFocus",
      "alt-up": "workspace::ActivatePaneUp",
      "ctrl-down": "editor::SelectSmallerSyntaxNode",
      "ctrl-g": "editor::SelectNext",
      "ctrl-k": "editor::DeleteLine",
      "ctrl-o": "tab_switcher::Toggle",
      "ctrl-p": "file_finder::Toggle",
      "ctrl-shift-w": "pane::CloseAllItems",
      "ctrl-t": "editor::Rename",
      "ctrl-u": "editor::FindAllReferences",
      "ctrl-up": "editor::SelectLargerSyntaxNode",
      "ctrl-w": "pane::CloseActiveItem"
    },
    "context": "Editor"
  },
  {
    "bindings": {
      "escape": "workspace::ActivatePreviousPane"
    },
    "context": "ProjectPanel || OutlinePanel || GitPanel || Terminal || NotificationPanel || DebugPanel"
  },
  {
    "bindings": {
      "ctrl-w": "tab_switcher::CloseSelectedItem"
    },
    "context": "TabSwitcher"
  },
  {
    "bindings": {
      "alt-t": "workspace::ToggleBottomDock"
    },
    "context": "Terminal"
  }
]
