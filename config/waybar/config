[
  {
    "output": "DP-3",
    "layer": "top",
    "height": 60,
    "fixed-center": true,
    "spacing": 1,
    "margin": "10 10 0 10",
    "reload_style_on_change": true,
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "mpris",
      "pulseaudio",
      "clock",
      "custom/notification",
      "custom/tray",
      "custom/control-center",
      "custom/power-menu"
    ],
    "hyprland/workspaces": {
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1",
      "format": "{icon}",
      "format-icons": {
        "1": "1",
        "2": "2",
        "3": "3",
        "4": "4"
      },
      "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": []
      },
      "all-outputs": false,
      "active-only": false,
      "show-special": false
    },
    "hyprland/window": {
      "format": "{}",
      "max-length": 48,
      "align": 0.5,
      "justify": "center"
    },
    "custom/control-center": {
      "format": "󰒓",
      "tooltip-format": "Control center",
      "on-click": "qs -c control-center ipc call controlCenter toggle"
    },
    "custom/tray": {
      "format": "󰀻",
      "tooltip-format": "System tray",
      "on-click": "qs -c control-center ipc call tray toggle"
    },
    "clock": {
      "format-alt": " {:%a %b %d}",
      "format": " {:%I:%M %p}",
      "tooltip": false
    },
    "mpris": {
      "player": "lazyt",
      "format": "{player_icon} {dynamic}",
      "format-paused": "{status_icon} {dynamic}",
      "player-icons": {
        "lazyt": "♫"
      },
      "status-icons": {
        "playing": "▶",
        "paused": "⏸"
      },
      "dynamic-order": ["title"],
      "max-length": 40,
      "on-click": "playerctl -p lazyt play-pause",
      "on-click-right": "playerctl -p lazyt next"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}% 󰂯",
      "format-bluetooth-muted": "󰖁 {icon} 󰂯",
      "format-muted": "󰖁 {volume}%",
      "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󱡒",
        "headset": "󰋎",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
          "",
          "",
          ""
        ]
      },
      "on-click": "$HOME/.config/hypr/scripts/launch-app pavucontrol",
      "on-scroll-up": "$HOME/.config/hypr/scripts/media-control volume-up",
      "on-scroll-down": "$HOME/.config/hypr/scripts/media-control volume-down",
      "scroll-step": 5,
      "smooth-scrolling-threshold": 1
    },
    "custom/power-menu": {
      "format": "⏻",
      "on-click": "$HOME/.config/wlogout/init.sh"
    },
    "custom/notification": {
      "exec": "~/.config/waybar/scripts/notification.sh",
      "on-click": "qs -c control-center ipc call notificationHistory toggle",
      "on-click-right": "dunstctl set-paused toggle",
      "return-type": "json",
      "max-length": 50,
       "format": "{}"
    }
  }
]
