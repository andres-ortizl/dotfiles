{
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "theme": "catppuccin-mocha-andrew",
  "quietStartup": true,
  "showCacheMissNotices": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 12000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60
  },
  "subagents": {
    "defaultModel": "openai/gpt-5.6-terra",
    "defaultThinking": "xhigh",
    "agentOverrides": {
      "scout": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "delegate": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "worker": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "context-builder": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      }
    }
  },
  "extensions": [
    "extensions/model-status.ts"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-lean-ctx",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-powerline-footer",
    "npm:pi-agent-browser-native",
    "npm:pi-hashline-edit-pro"
  ],
  "lastChangelogVersion": "0.84.2",
  "hideThinkingBlock": true
}