{
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 12000,
    "reserveTokens": 128000
  },
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "xhigh",
  "extensions": [
    "extensions/model-status.ts"
  ],
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-lean-ctx",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-powerline-footer",
    "npm:pi-agent-browser-native",
    "npm:pi-hashline-edit-pro",
    "npm:pi-mcp-adapter@2.32.1",
    "npm:context-mode",
    "../../code/pi-beacon",
    "git:github.com/andres-ortizl/pi-beacon@v1.1.0"
  ],
  "quietStartup": true,
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "showCacheMissNotices": false,
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "delegate": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "worker": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "xhigh"
      }
    },
    "defaultModel": "openai/gpt-5.6-terra",
    "defaultThinking": "xhigh"
  },
  "terminal": {
    "imageWidthCells": 60,
    "showImages": true
  },
  "theme": "catppuccin-mocha-andrew"
}
