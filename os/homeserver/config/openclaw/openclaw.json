{
  "agents": {
    "defaults": {
      "heartbeat": {
        "every": "0m"
      },
      "maxConcurrent": 1,
      "model": {
        "primary": "openai/gpt-sol"
      },
      "models": {
        "openai/gpt-5.4": {
          "agentRuntime": {
            "id": "openclaw"
          }
        },
        "openai/gpt-5.4-mini": {
          "agentRuntime": {
            "id": "openclaw"
          }
        },
        "openai/gpt-sol": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "skills": [
        "knowledge-capture"
      ],
      "timeoutSeconds": 300,
      "userTimezone": "Europe/Madrid",
      "utilityModel": "openai/gpt-5.4-mini",
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "channels": {
    "whatsapp": {
      "allowFrom": [
        "${OPENCLAW_OWNER_PHONE}"
      ],
      "dmPolicy": "allowlist",
      "groupPolicy": "disabled"
    }
  },
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    },
    "mode": "local"
  },
  "memory": {
    "search": {
      "extraPaths": [
        "/home/node/.openclaw/workspace/knowledge"
      ],
      "model": "text-embedding-3-small",
      "provider": "openai"
    }
  },
  "plugins": {
    "allow": [
      "openai",
      "memory-core",
      "memory-wiki",
      "whatsapp"
    ],
    "entries": {
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        },
        "enabled": true
      },
      "memory-wiki": {
        "config": {
          "ingest": {
            "autoCompile": true
          },
          "render": {
            "createBacklinks": true,
            "createDashboards": true,
            "preserveHumanBlocks": true
          },
          "search": {
            "backend": "shared",
            "corpus": "wiki"
          },
          "vault": {
            "path": "/home/node/.openclaw/workspace/knowledge",
            "renderMode": "obsidian"
          },
          "vaultMode": "isolated"
        },
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      }
    },
    "slots": {
      "memory": "memory-core"
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "agentToAgent": {
      "enabled": false
    },
    "allow": [
      "read",
      "write",
      "edit",
      "memory_search",
      "memory_get",
      "web_fetch",
      "wiki_status",
      "wiki_search",
      "wiki_get",
      "wiki_apply",
      "wiki_lint",
      "session_status"
    ],
    "deny": [
      "group:runtime",
      "group:ui",
      "group:nodes",
      "group:automation",
      "sessions_spawn"
    ],
    "elevated": {
      "enabled": false
    },
    "exec": {
      "ask": "always",
      "security": "deny"
    },
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "self"
    },
    "web": {
      "fetch": {
        "enabled": true,
        "maxChars": 50000,
        "maxCharsCap": 50000,
        "maxResponseBytes": 2000000,
        "timeoutSeconds": 30
      },
      "search": {
        "enabled": false
      }
    }
  }
}
