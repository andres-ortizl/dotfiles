# Homeserver Configuration
# This documents the Compose interpolation attachment `homeserver.env`.
# Restore runtime files from the Bitwarden item n33lab-homeserver-runtime with
# ./recover-env.sh. Never copy real values into this tracked template.
# Validate without deployment: ./deploy.sh --check

# Domain Configuration
DOMAIN=n33lab.com

# ACME DNS-01 production defaults; set both values explicitly for a staging override.
ACME_EMAIL=admin@example.com
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_STORAGE=/letsencrypt/acme.json

# User and Group IDs (run 'id' command to get your values)
PUID=1000
PGID=1000

# Timezone
TZ=Europe/Madrid

# Storage Paths
DATA_ROOT=./data/shared
UPLOAD_LOCATION=./data/immich

# Database Configuration (Immich)
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Pi-hole Configuration
PIHOLE_PASSWORD=
PIHOLE_DNS=1.1.1.1;1.0.0.1
PIHOLE_API_KEY=

# Tailscale Configuration
TS_AUTHKEY=

# Dedicated ignored attachments restored under secrets/:
# immich-server.env: DB_USERNAME, DB_PASSWORD, DB_DATABASE_NAME
# immich-ml.env: empty by default; only documented ML overrides are permitted
# gatus.env: GATUS_USERNAME, GATUS_PASSWORD_BCRYPT_BASE64
# cloudflare_dns_api_token, traefik-users, esphome.env, mqtt-passwd, mqtt-acl
# qa-manifest.env: MODE, the seven protected *_FILE references, and CHECKS_DIR
# qa-external.env: MODE, WAN/NAS/DNS reference files, and external probe command
# qa-worker.env: NAS_ENDPOINT and EXTERNAL_ENDPOINT
# qa-nas-credentials.env: protected test-only credential values
